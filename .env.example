# Server configuration
PORT=4000
HOST=0.0.0.0
RUST_LOG=secscan_api=info,secscan_core=info,tower_http=info

# Scanner limits & timeouts
SCAN_CONCURRENCY=15
MAX_DOMAINS_PER_REQUEST=500
HOP_TIMEOUT_MS=7000
GLOBAL_TIMEOUT_MS=20000
MAX_REDIRECTS=5

# Security & SSRF policy
# Set to true ONLY when scanning internal/intranet networks in trusted environments
ALLOW_PRIVATE_NETWORKS=false
# Set to true ONLY if internal targets use self-signed TLS certificates
ALLOW_SELF_SIGNED_TLS=false
# Comma-separated allowed CORS origins (leave empty for same-origin only, or "*" for dev)
CORS_ORIGIN=

# Rate limiting (per IP)
RATE_LIMIT_PER_MINUTE=30

# Previous scan YAML snapshot storage
LAST_SCAN_PATH=./data/last-scan.yaml
